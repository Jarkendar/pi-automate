# Courses Hub - reverse proxy, basic auth, static files
#
# All routes live under /dashboard/courses/ so the root URL is free for
# future modules. Anything outside the prefix returns 404.
#
# Auth credentials come from .env:
#   COURSES_HUB_USER       - username (default "jarek")
#   COURSES_HUB_PASS_HASH  - bcrypt hash (generate with scripts/courses-setup-auth.sh)

{
	admin off
	auto_https off
	log {
		output stdout
		format console
		level INFO
	}
}

http://, http://courses.lan {
	encode zstd gzip

	# Basic auth for the whole module
	@module path /dashboard/courses /dashboard/courses/*
	basic_auth @module {
		{$COURSES_HUB_USER:jarek} {$COURSES_HUB_PASS_HASH}
	}

	# Caddy sorts `handle` directives by specificity (longer prefix wins).
	# So /dashboard/courses/api/* matches before /dashboard/courses/* even
	# though both are declared at the same level.

	# 1. API -> backend
	handle /dashboard/courses/api/* {
		uri strip_prefix /dashboard/courses
		reverse_proxy courses_hub_pi_automate:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 15s
			}
		}
	}

	# 2. Patched course HTMLs and manifest.json
	handle /dashboard/courses/courses/* {
		uri strip_prefix /dashboard/courses/courses
		root * /srv/courses
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# 3. Dashboard index (exact paths)
	@module_root path /dashboard/courses /dashboard/courses/
	handle @module_root {
		root * /srv/frontend
		rewrite * /index.html
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# 4. Dashboard static assets (e.g. courses-sync.js)
	# Catches anything under the module not matched by handlers above.
	handle /dashboard/courses/* {
		uri strip_prefix /dashboard/courses
		root * /srv/frontend
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# Anything else: 404 (root is reserved for future modules)
	handle {
		respond 404
	}
}
